  m_Text: "\u0428\u043B\u0435\u043C \u043B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0433\u043E
    \u0432\u043E\u0438\u043D\u0430, \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0433\u043E
    \u0442\u044B\u0441\u044F\u0447\u0443 \u0431\u0438\u0442\u0432. \u0423\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442
    \u0441\u0438\u043B\u0443 \u0443\u0434\u0430\u0440\u0430 \u0438 \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442
    \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0430\u0442\u0430\u043A\u0438
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432\u043E \u0432\u0440\u0430\u0433\u0430."
